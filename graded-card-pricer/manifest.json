{
  "manifest_version": 3,
  "name": "Graded Card Pricer",
  "version": "1.0.0",
  "description": "Detects graded Pokémon cards in emails and pages, then aggregates recent sold prices from eBay, PriceCharting, 130point, Alt and Collectr.",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "Graded Card Pricer" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "options_page": "src/options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.alt.xyz/*", "*://alt.xyz/*", "*://*.getcollectr.com/*"],
      "js": ["src/detect.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.alt.xyz/*", "*://alt.xyz/*", "*://*.getcollectr.com/*", "*://*.ebay.com/*", "*://*.pricecharting.com/*", "*://*.130point.com/*"],
      "js": ["src/detect.js", "src/frame-scraper.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
