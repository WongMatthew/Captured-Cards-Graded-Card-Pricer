{
  "manifest_version": 3,
  "name": "Graded Card Pricer",
  "version": "5.1.0",
  "description": "Spots graded Pokémon cards and cert numbers in emails and pages and shows recent sold prices in CAD from eBay.ca, Terapeak, 130point, PriceCharting, SNKRDUNK, Pokemon Price Tracker, Card Ladder and Alt.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Graded Card Pricer"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open Graded Card Pricer"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/detect.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.ebay.ca/sch/*",
        "*://*.ebay.com/sch/*"
      ],
      "js": [
        "src/detect.js",
        "src/platforms.js",
        "src/ebay-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.psacard.com/cert/*",
        "*://*.cgccards.com/certlookup/*"
      ],
      "js": [
        "src/detect.js",
        "src/cert-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://130point.com/sales*",
        "*://*.130point.com/sales*"
      ],
      "js": [
        "src/detect.js",
        "src/platforms.js",
        "src/point130-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.alt.xyz/*",
        "*://alt.xyz/*"
      ],
      "js": [
        "src/mobile-shim.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.alt.xyz/*",
        "*://alt.xyz/*",
        "*://*.cardladder.com/*",
        "*://cardladder.com/*",
        "*://snkrdunk.com/*",
        "*://*.snkrdunk.com/*",
        "*://*.ebay.ca/sh/research*",
        "*://*.ebay.com/sh/research*"
      ],
      "js": [
        "src/detect.js",
        "src/frame-scraper.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}